{
  "name": "trrbot-ts-bolt",
  "version": "2.2.4",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Slack Bolt アプリケーション（TypeScript）",
  "engines": {
    "node": ">=26 <27"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "better-sqlite3": "^13.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.6",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "minimatch": {
      "brace-expansion": "5.0.9"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,yaml,yml,toml,html,css,scss,less,md,mdx,graphql,gql,vue,svelte,astro}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
